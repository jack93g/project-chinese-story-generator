# Base URL of the FastAPI backend. Copy this file to .env.local and adjust
# if the API runs on a different host or port. Use "localhost", not
# 127.0.0.1: the frontend runs on localhost, and the browser only sends the
# login cookie to an API on the same site.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Tag Manager. Leave all three unset to run without GTM.
# With only the container ID, the Live container loads. The other two come
# from the "dev" Environment's snippet in GTM (Admin > Environments > Get
# Snippet) and make the local dev server load that Environment instead.
# Keep the auth value out of the repo and out of the GitHub Pages build: it
# lets anyone load the dev Environment's unpublished tags, and NEXT_PUBLIC_*
# values can be read from the built site.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GTM_AUTH=
# NEXT_PUBLIC_GTM_PREVIEW=env-N
