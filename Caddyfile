api.huaben.app {
	encode gzip

	# Reject oversized request bodies at the edge, before they reach the API.
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# No trusted_proxies here on purpose: without it, Caddy discards any
	# X-Forwarded-For the client sends and sets it to the real connecting
	# address, which the API trusts (FORWARDED_ALLOW_IPS in
	# docker-compose.prod.yml). Putting a proxy (e.g. Cloudflare) in front
	# means revisiting both, or callers could spoof their address.
	reverse_proxy api:8000
}
